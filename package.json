{
  "name": "gatsby-universal",

  "author": "Fabian Schultz <desk@fabianschultz.com>",
  "scripts": {
    "develop": "gatsby develop",
    "serve": "gatsby serve",
    "ssr": "npm run build && npm run serve",
    "format": "prettier --config ./.prettierrc --write src/**/*.js",
    "build:dir": "mkdirp ./public/icons/",
    "build:favicons": "node scripts/favicons",
    "build": "npm run build:dir && npm run build:favicons && gatsby build",
    "test": "ava **/*.test.js --verbose"
  },
  "greenkeeper": {
    "ignore": [
      "ava",
      "core-js"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "babel-plugin-styled-components": "^2.1.4",
    "framer-motion": "^11.0.0",
    "gatsby": "^5.15.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-offline": "^6.15.0",
    "gatsby-plugin-react-svg": "^3.3.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-plugin-styled-components": "^6.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-json": "^5.15.0",
    "gatsby-transformer-remark": "^6.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.13",
    "webpack": "^5.98.0"
  },
  "devDependencies": {
    "ava": "^6.0.0",
    "chrome-launcher": "^1.1.0",
    "core-js": "^3.40.0",
    "directory-named-webpack-plugin": "^4.0.0",
    "favicons": "^7.0.2",
    "lighthouse": "^12.0.0",
    "mkdirp": "^3.0.1",
    "node-gyp": "^10.0.0",
    "prettier": "^3.3.3"
  },
  "overrides": {
    "react-server-dom-webpack": {
      "react": "^18.2.0"
    },
    "ajv": "^8.17.1",
    "babel-loader": {
      "ajv": "^6.12.6"
    },
    "mini-css-extract-plugin": {
      "ajv": "^6.12.6"
    },
    "eslint-webpack-plugin": {
      "ajv": "^6.12.6"
    },
    "css-loader": {
      "ajv": "^6.12.6"
    },
    "css-minimizer-webpack-plugin": {
      "ajv": "^6.12.6"
    },
    "file-loader": {
      "ajv": "^6.12.6"
    },
    "fork-ts-checker-webpack-plugin": {
      "ajv": "^6.12.6"
    },
    "null-loader": {
      "ajv": "^6.12.6"
    },
    "raw-loader": {
      "ajv": "^6.12.6"
    },
    "style-loader": {
      "ajv": "^6.12.6"
    },
    "url-loader": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "eslint": {
      "ajv": "^6.12.6"
    }
  }
}
